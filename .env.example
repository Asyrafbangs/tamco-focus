# TAMCO Focus — environment template
#
# Copy to `.env.local` for local development:
#   Windows PowerShell : Copy-Item .env.example .env.local
#   Unix shell         : cp .env.example .env.local
#
# `scripts/setup-local.ps1` / `scripts/setup-local.sh` fill the Supabase values
# automatically from `supabase status`. Never commit a populated .env file.

# ---------------------------------------------------------------------------
# Environment identity
# ---------------------------------------------------------------------------
# local | staging | production. Every destructive script resolves the target
# from this AND the Supabase URL, and refuses when the two disagree or when a
# remote URL carries no declaration. Never inferred, never guessed.
TAMCO_ENV=local

# ---------------------------------------------------------------------------
# Supabase — local stack
# ---------------------------------------------------------------------------
# Browser-visible. Safe to expose: the anon key is constrained by RLS.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS. Never prefix with NEXT_PUBLIC_ and never send to
# the browser. Used exclusively by administrator user-provisioning and the
# weekly email worker, both of which re-check authorisation in application code.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Organisation policy
# ---------------------------------------------------------------------------
# Timezone used to render durations and to decide when a date-only commitment
# becomes overdue. Timestamps are always stored in UTC.
ORG_TIMEZONE=Asia/Kuala_Lumpur

# Weekly summary schedule, expressed in ORG_TIMEZONE.
WEEKLY_SUMMARY_DAY=monday
WEEKLY_SUMMARY_HOUR=8

# ---------------------------------------------------------------------------
# Attachments
# ---------------------------------------------------------------------------
# Local defaults. Final production limits remain a Product Owner decision
# (MASTER_PRODUCT_SPEC.md section 30, item 1).
ATTACHMENT_MAX_BYTES=10485760
# Which file types may be attached.
#
# Deliberately left unset. The list lived here as well as in
# src/domain/attachment-policy.ts, the two drifted, and the copy here was the
# stale one: it had no PowerPoint, no Word, no Excel and no HEIC, while the
# storage bucket and the file chooser all offered them. Nothing showed it
# locally, because a developer's .env.local has no such line and so gets the
# full list -- but scripts/write-env.mjs creates .env.local from this file
# when none exists, which is every CI run, so CI alone refused a .pptx and
# the end-to-end check for exactly that file type failed on main for a day.
#
# Unset means DEFAULT_ALLOWED_MIME_TYPES, which is the one list the bucket
# and the chooser are built from. Set it only to narrow that, never to
# restate it.
# ATTACHMENT_ALLOWED_MIME=
# Signed attachment URLs expire after this many seconds.
ATTACHMENT_SIGNED_URL_TTL_SECONDS=120

# Virus scanning is NOT implemented locally. Leaving this `false` is honest:
# no scan is performed and no scan result is fabricated. See
# docs/future-deployment.md for the pre-production gate.
ATTACHMENT_VIRUS_SCAN_ENABLED=false

# ---------------------------------------------------------------------------
# Email delivery
# ---------------------------------------------------------------------------
# Three transports, and no fourth. An unrecognised value is now an error
# rather than a silent fall back to `log`, which is how notification email
# could look healthy in Production while delivering nothing.
#
#   log       renders into the delivery log and stdout, sends nothing.
#             Correct locally; catastrophic if it is the Production setting
#             nobody noticed.
#   inbucket  the local capture server the Supabase stack runs on 54325.
#   smtp      a real relay. Requires HOST, PORT, USER, PASSWORD and FROM; the
#             run fails rather than starting half-configured.
#
# For `smtp`, port 465 uses implicit TLS and anything else is upgraded with
# STARTTLS. A relay that will not offer STARTTLS is refused rather than used in
# plaintext.
EMAIL_TRANSPORT=log
EMAIL_FROM=focus@tamco.local
EMAIL_FROM_NAME=TAMCO Focus
EMAIL_SMTP_HOST=127.0.0.1
EMAIL_SMTP_PORT=54325
# Only for EMAIL_TRANSPORT=smtp. Never commit real values: this file is the
# example, `.env.local` is the one that is gitignored.
#
# Microsoft 365 / company Outlook:
#   EMAIL_SMTP_HOST=smtp.office365.com
#   EMAIL_SMTP_PORT=587           STARTTLS. The transport refuses to downgrade.
#   EMAIL_SMTP_USER=              the mailbox you authenticate as
#   EMAIL_SMTP_PASSWORD=          an app password where the tenant requires one
#   EMAIL_FROM=                   must equal EMAIL_SMTP_USER, or that mailbox
#                                 needs Send As rights, or Microsoft answers
#                                 550 5.7.60 SendAsDenied
#
# SMTP AUTH is disabled per-mailbox by default in Microsoft 365 and cannot
# satisfy MFA. Ask IT to enable it for this one mailbox, or move to Graph.
#
# Check it before deploying, without printing the password:
#   npm run mail:verify -- you@tamco.com.my
# EMAIL_SMTP_USER=
# EMAIL_SMTP_PASSWORD=
APP_BASE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Local seed accounts
# ---------------------------------------------------------------------------
# Password applied to every seeded local-only account. Local fixtures only —
# these accounts must never be created in a hosted environment.
#
# Intentionally blank. `scripts/setup-local.*` generates a value into
# `.env.local`; a password committed here would be a plaintext password in the
# repository, which is prohibited regardless of how little it protects.
SEED_USER_PASSWORD=

# ---------------------------------------------------------------------------
# Hosted environments only
# ---------------------------------------------------------------------------
# Postgres connection string, needed only by `npm run backup:database` against a
# hosted project. Supply it in the shell for that one command; never store it.
SUPABASE_DB_URL=

# Shared secret the scheduled-work endpoint requires. Vercel Cron sends it as
# `Authorization: Bearer <value>`; without it the endpoint refuses, so nobody
# can trigger background work by visiting a URL.
CRON_SECRET=

# Where a backup is written. Defaults to a sibling of the repository so a backup
# can never land inside it and be committed.
TAMCO_BACKUP_DIR=
