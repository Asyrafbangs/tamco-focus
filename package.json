{
  "name": "tamco-focus",
  "version": "30.0.0",
  "private": true,
  "description": "TAMCO Focus — lean work-management system. Local-first build.",
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/database.types.ts",
    "db:types:check": "node scripts/check-generated-types.mjs",
    "db:test": "supabase test db",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "smoke": "node scripts/smoke-test.mjs",
    "scan:secrets": "node scripts/scan-secrets.mjs",
    "preflight": "node scripts/preflight.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.58.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "server-only": "^0.0.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3.3.6",
    "@playwright/test": "^1.55.1",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "dotenv": "^17.2.2",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "pg-query-emscripten": "^5.1.0",
    "prettier": "^3.6.2",
    "supabase": "^2.48.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
